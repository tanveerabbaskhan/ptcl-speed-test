---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, canonical, schema, noindex = false } = Astro.props;
const siteUrl = 'https://ptcl-speed-test.pages.dev';
const pageUrl = canonical ? `${siteUrl}${canonical}` : Astro.url.href;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/speed-test', label: 'Speed Test' },
  { href: '/speedtest', label: 'Providers' },
  { href: '/packages', label: 'Packages' },
  { href: '/guides', label: 'Guides' },
  { href: '/tools', label: 'Tools' },
  { href: '/cities', label: 'Cities' },
  { href: '/faq', label: 'FAQ' },
  { href: '/about', label: 'About' },
];
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(href + '/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="PTCL Speed Test" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="logo" href="/" aria-label="PTCL Speed Test — home">
          <svg viewBox="0 0 64 64" aria-hidden="true">
            <rect width="64" height="64" rx="14" fill="#0057A8" />
            <path d="M14 44a18 18 0 0 1 36 0" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" />
            <line x1="32" y1="44" x2="44" y2="30" stroke="#00C2D1" stroke-width="5" stroke-linecap="round" />
            <circle cx="32" cy="44" r="4.5" fill="#fff" />
          </svg>
          <span>PTCL <em>Speed Test</em></span>
        </a>
        <button class="menu-toggle" id="menu-toggle" aria-label="Toggle menu" aria-expanded="false">☰</button>
        <nav class="main-nav" id="main-nav" aria-label="Main navigation">
          {nav.map((item) => (
            <a href={item.href} class={isActive(item.href) ? 'active' : undefined}>{item.label}</a>
          ))}
          <a href="/speed-test" class="nav-cta">Test My Speed</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <p class="footer-heading">PTCL Speed Test</p>
            <p>
              A free, independent tool to check your PTCL broadband speed in Pakistan —
              download, upload, ping and jitter — plus plain-English guides on what your
              results mean and how to make your connection faster.
            </p>
          </div>
          <div>
            <p class="footer-heading">Tools</p>
            <ul>
              <li><a href="/speed-test">Internet Speed Test</a></li>
              <li><a href="/speedtest">Speed Tests by Provider</a></li>
              <li><a href="/compare">Compare Providers</a></li>
              <li><a href="/statistics">Speed Statistics</a></li>
              <li><a href="/packages">PTCL Packages &amp; Speeds</a></li>
              <li><a href="/cities">Internet Speed by City</a></li>
              <li><a href="/best-internet-provider-pakistan">Best ISP in Pakistan</a></li>
              <li><a href="/tools">All Tools</a></li>
              <li><a href="/faq">Speed Test FAQ</a></li>
            </ul>
          </div>
          <div>
            <p class="footer-heading">Guides</p>
            <ul>
              <li><a href="/guides/understanding-your-results">Understanding Your Results</a></li>
              <li><a href="/guides/improve-ptcl-speed">How to Improve PTCL Speed</a></li>
              <li><a href="/guides/ping-jitter-explained">Ping &amp; Jitter Explained</a></li>
              <li><a href="/guides/ptcl-router-login">PTCL Router Login</a></li>
              <li><a href="/guides/5g-in-pakistan">5G in Pakistan</a></li>
              <li><a href="/guides/how-much-speed-do-i-need">How Much Speed Do I Need?</a></li>
              <li><a href="/guides">All Guides</a></li>
            </ul>
          </div>
          <div>
            <p class="footer-heading">Site</p>
            <ul>
              <li><a href="/about">About Us</a></li>
              <li><a href="/contact">Contact</a></li>
              <li><a href="/privacy-policy">Privacy Policy</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} PTCL Speed Test. All rights reserved.</span>
          <span>An independent tool. Not affiliated with or endorsed by PTCL or Etisalat.</span>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('menu-toggle');
      const nav = document.getElementById('main-nav');
      toggle?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>
