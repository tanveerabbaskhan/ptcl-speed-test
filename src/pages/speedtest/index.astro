---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { providers } from '../../data/providers';
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ptcl-speed-test.pages.dev/' },
    { '@type': 'ListItem', position: 2, name: 'Speed Tests', item: 'https://ptcl-speed-test.pages.dev/speedtest' },
  ],
};

---

<BaseLayout
  title="Speed Tests by Provider: PTCL, Jazz, Zong, Nayatel"
  description="Free speed tests for every major Pakistani provider: PTCL, Nayatel, StormFiber, Jazz, Zong, Telenor, Wateen and more. Test download, upload, ping and jitter."
  canonical="/speedtest"
  schema={breadcrumbSchema}
>
  <section class="page-head">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-current="page">Speed Tests</li>
        </ol>
      </nav>
      <h1>Speed Tests by Provider</h1>
      <p class="lead">
        Pick your provider for a test tuned to your connection, fibre, mobile data or
        wireless, with advice written for that kind of line.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cards">
        {providers.map((p) => (
          <a class="card card-link" href={`/speedtest/${p.slug}`}>
            <h2>{p.name} Speed Test</h2>
            <p>{p.typeLabel}, {p.coverage}</p>
          </a>
        ))}
      </div>
      <p class="center" style="margin-top: 2rem;">
        Not sure which you have? The <a href="/speed-test">general speed test</a> works
        for any connection.
      </p>
    </div>
  </section>
</BaseLayout>
