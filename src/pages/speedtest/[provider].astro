---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpeedTest from '../../components/SpeedTest.astro';
import { providers, typeAdvice, type Provider } from '../../data/providers';

export function getStaticPaths() {
  return providers.map((provider) => ({
    params: { provider: provider.slug },
    props: { provider },
  }));
}

interface Props {
  provider: Provider;
}

const { provider } = Astro.props;
const advice = typeAdvice[provider.type];
const others = providers.filter((p) => p.slug !== provider.slug);
const isMobile = provider.type === 'mobile' || provider.type === 'wireless';
const isFibre = provider.type === 'fibre';

// Related issue guides per provider (slug -> guide links).
const guideLinks: Record<string, { href: string; label: string }[]> = {
  'ptcl-speed-test': [
    { href: '/guides/ptcl-internet-slow', label: 'PTCL internet slow? Fix it in order' },
    { href: '/guides/ptcl-router-lights', label: 'PTCL router lights explained (DSL, LOS, PON)' },
    { href: '/guides/ptcl-router-login', label: 'PTCL router login & WiFi password change' },
    { href: '/guides/reduce-ping-gaming', label: 'Reduce ping for gaming (incl. PTCL FastPath)' },
  ],
  'ptcl-flash-fiber': [
    { href: '/guides/ptcl-internet-slow', label: 'PTCL internet slow? Fix it in order' },
    { href: '/guides/ptcl-router-lights', label: 'Fibre ONT lights: LOS red, PON explained' },
    { href: '/guides/reduce-ping-gaming', label: 'Reduce ping for gaming' },
  ],
  evo: [
    { href: '/guides/ptcl-internet-slow', label: 'PTCL internet slow? Fix it in order' },
    { href: '/guides/troubleshoot-slow-internet', label: 'Troubleshoot by symptom' },
  ],
  jazz: [
    { href: '/guides/jazz-internet-slow', label: 'Jazz internet slow? Fix slow Jazz 4G' },
    { href: '/guides/jazz-apn-settings', label: 'Jazz APN & internet settings' },
    { href: '/guides/reduce-ping-gaming', label: 'Reduce ping for gaming on mobile data' },
  ],
};
const defaultGuideLinks = [
  { href: '/guides/troubleshoot-slow-internet', label: 'Slow internet? Troubleshoot by symptom' },
  { href: '/guides/understanding-your-results', label: 'Understanding your speed test results' },
  { href: '/guides/ping-jitter-explained', label: 'Ping & jitter explained' },
];
const relatedGuides = guideLinks[provider.slug] ?? defaultGuideLinks;
const compareLinks: Record<string, { href: string; label: string }[]> = {
  'ptcl-speed-test': [
    { href: '/compare/ptcl-vs-nayatel', label: 'PTCL vs Nayatel' },
    { href: '/compare/ptcl-vs-transworld', label: 'PTCL vs Transworld' },
  ],
  nayatel: [{ href: '/compare/ptcl-vs-nayatel', label: 'PTCL vs Nayatel' }],
  transworld: [{ href: '/compare/ptcl-vs-transworld', label: 'PTCL vs Transworld' }],
  jazz: [{ href: '/compare/jazz-vs-zong', label: 'Jazz vs Zong' }],
  zong: [{ href: '/compare/jazz-vs-zong', label: 'Jazz vs Zong' }],
};

const faqs = [
  {
    q: `How do I check my ${provider.name} internet speed?`,
    a: `Press "Start Speed Test" on this page. The test takes under 30 seconds and measures your download speed, upload speed, ping and jitter against the nearest server. No sign-up or app is needed.`,
  },
  {
    q: `What is a good speed for ${provider.name}?`,
    a: isMobile
      ? `For mobile data, 10–20 Mbps down is good for HD video and calls; 5 Mbps is enough for browsing and messaging. Ping under 80 ms feels fine on mobile — under 50 ms is great for gaming.`
      : `For most homes, 10–15 Mbps covers HD streaming and video calls; 25 Mbps or more handles 4K and several people online at once. Ping under 50 ms is good, and jitter under 30 ms keeps calls smooth.`,
  },
  {
    q: `Why is my ${provider.name} speed slow?`,
    a: isMobile
      ? `Usually signal: weak coverage, distance from the tower, or a busy cell at peak hours. Move near a window or outdoors, check you're on 4G, and test again. If it's slow everywhere at all times, the issue may be your device or SIM.`
      : `Usually Wi-Fi, too many devices sharing the connection, or peak-hour congestion. Test over an Ethernet cable first: if the wired result is close to your package speed, your line is fine and the fix is in your home setup.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ptcl-speed-test.pages.dev/' },
    { '@type': 'ListItem', position: 2, name: 'Speed Tests by Provider', item: 'https://ptcl-speed-test.pages.dev/speedtest' },
    { '@type': 'ListItem', position: 3, name: `${provider.name} Speed Test`, item: `https://ptcl-speed-test.pages.dev/speedtest/${provider.slug}` },
  ],
};
---

<BaseLayout
  title={`${provider.name} Speed Test — Check Your ${provider.name} Internet Speed`}
  description={`Free ${provider.name} speed test. Measure your ${provider.name} download speed, upload speed, ping and jitter in under 30 seconds — no sign-up needed.`}
  canonical={`/speedtest/${provider.slug}`}
  schema={[faqSchema, breadcrumbSchema]}
>
  <section class="page-head">
    <div class="container">
      <p class="breadcrumbs"><a href="/">Home</a> / <a href="/speedtest">Speed Tests</a> / {provider.name}</p>
      <h1>{provider.name} Speed Test</h1>
      <p class="lead">{provider.about}</p>
      <p class="small muted">{provider.typeLabel} · {provider.coverage}</p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width: 720px;">
      <SpeedTest />

      {provider.typical && (
        <>
          <h2>What speed do most {provider.name} users get?</h2>
          <p>
            Published averages give you a benchmark for your own result. Your line can
            legitimately be faster or slower than these figures — they mix many packages,
            cities and devices.
          </p>
          <table class="data-table">
            <thead>
              <tr><th>Average</th><th>Download</th><th>Upload</th>{provider.typical.ping && <th>Ping</th>}</tr>
            </thead>
            <tbody>
              <tr>
                <td>{provider.name}</td>
                <td>{provider.typical.download}</td>
                <td>{provider.typical.upload}</td>
                {provider.typical.ping && <td>{provider.typical.ping}</td>}
              </tr>
            </tbody>
          </table>
          <p class="small muted">
            Source: <a href={provider.typical.sourceUrl} target="_blank" rel="noopener">{provider.typical.source}</a>.
            See all providers on our <a href="/statistics">Pakistan internet speed statistics</a> page.
          </p>
        </>
      )}

      <h2>How to check your {provider.name} speed</h2>
      <ol>
        {advice.tips.map((tip) => (
          <li>{tip}</li>
        ))}
      </ol>

      {provider.type === 'mobile' && (
        <>
          <h2>Testing on your phone</h2>
          <p>
            A mobile speed test measures the connection your phone is actually using, so
            the setup matters more than the test itself.
          </p>
          <h3>On Android</h3>
          <p>
            Turn Wi-Fi off so the phone uses mobile data, then open this page in Chrome
            and press Start. Check the status bar shows 4G — if it shows 3G or H+, move
            somewhere with better signal first.
          </p>
          <h3>On iPhone</h3>
          <p>
            Same process in Safari or Chrome: Wi-Fi off, mobile data on, then run the
            test. iPhones show the network type (4G/5G) next to the signal bars.
          </p>
          <h3>On a 4G hotspot or dongle</h3>
          <p>
            Connect your laptop to the hotspot, then test from the laptop browser. Place
            the hotspot device near a window — its signal decides your speed.
          </p>
        </>
      )}

      {isFibre && (
        <>
          <h2>Wired or Wi-Fi? Test both</h2>
          <p>
            On fibre, the line itself is rarely the problem. A wired test (Ethernet cable
            from the router to a laptop) shows what your line delivers; a Wi-Fi test shows
            what your devices actually get. If wired is fast and Wi-Fi is slow, the fix is
            your router placement or the Wi-Fi band — connect to the 5&nbsp;GHz network
            near the router, and 2.4&nbsp;GHz further away. See our guide on
            <a href="/guides/improve-ptcl-speed"> how to improve your speed</a> for the
            full checklist.
          </p>
        </>
      )}

      <h2>What affects your {provider.name} speed?</h2>
      <ul>
        {advice.factors.map((factor) => (
          <li>{factor}</li>
        ))}
      </ul>

      <h2>What do the results mean?</h2>
      <p>
        <strong>Download</strong> is how fast data reaches you — the number your package
        advertises. <strong>Upload</strong> is how fast you send data, which matters for
        video calls and sending files. <strong>Ping</strong> is responsiveness (under
        50&nbsp;ms is good), and <strong>jitter</strong> is how steady that ping is
        (under 30&nbsp;ms keeps calls and games smooth).
        <a href="/guides/understanding-your-results">Read the full guide →</a>
      </p>

      <h2>{provider.name} speed test FAQ</h2>
      <div class="faq-list" style="margin-top: 1rem;">
        {faqs.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>

      <h2>Related guides</h2>
      <ul>
        {relatedGuides.map((g) => (
          <li><a href={g.href}>{g.label}</a></li>
        ))}
      </ul>

      <div class="cta-band">
        <h2>Compare {provider.name} with the alternatives</h2>
        <p>
          {compareLinks[provider.slug]
            ? <>See how {provider.name} stacks up on speed, latency and coverage — with published data, not marketing claims.</>
            : <>See how Pakistan's providers compare on speed, latency and coverage — with published data, not marketing claims.</>}
        </p>
        <div class="cta-links">
          {(compareLinks[provider.slug] ?? [{ href: '/compare', label: 'All provider comparisons' }]).map((c) => (
            <a class="btn btn-secondary" href={c.href}>{c.label} →</a>
          ))}
          <a class="btn btn-secondary" href="/statistics">Speed statistics →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <h2 class="center">Test another provider</h2>
      <div class="cards">
        {others.map((p) => (
          <a class="card card-link" href={`/speedtest/${p.slug}`}>
            <h3>{p.name} Speed Test</h3>
            <p>{p.typeLabel}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
