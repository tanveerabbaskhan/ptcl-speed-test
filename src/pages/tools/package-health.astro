---
import BaseLayout from '../../layouts/BaseLayout.astro';

const faqs = [
  {
    q: 'What percentage of my package speed should I get?',
    a: 'At least 80% on a wired test at a quiet time. If you pay for 30 Mbps and consistently get under 24 Mbps wired, something is wrong, and you have grounds to complain. Below 50% is a clear fault, not a grey area.',
  },
  {
    q: 'Why is my Wi-Fi speed lower than my wired speed?',
    a: 'Wi-Fi almost always reads slower than the line itself, distance, walls, interference and the Wi-Fi band all eat speed. That’s why this checker asks for a wired result: it tells you whether the line is the problem or your home setup is. If wired is healthy and Wi-Fi is slow, see our Wi-Fi signal guide.',
  },
  {
    q: 'My upload is much slower than my download. Is that normal?',
    a: 'On DSL, yes, uploads of 1–1.5 Mbps are normal even on a 20 Mbps package. On fibre, no, uploads should be close to downloads, so a 30 Mbps fibre line with a 2 Mbps upload has a problem. On mobile data, uploads of 4–8 Mbps are normal.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ptcl-speed-test.pages.dev/' },
    { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://ptcl-speed-test.pages.dev/tools' },
    { '@type': 'ListItem', position: 3, name: 'Package Health Checker', item: 'https://ptcl-speed-test.pages.dev/tools/package-health' },
  ],
};
---

<BaseLayout
  title="Package Health Checker: Are You Getting Your Speed?"
  description="Check whether your connection delivers what your package promises: enter your package speed and your measured result, and get a verdict against the 80% rule."
  canonical="/tools/package-health"
  schema={[faqSchema, breadcrumbSchema]}
>
  <section class="page-head">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/tools">Tools</a></li>
          <li aria-current="page">Package Health Checker</li>
        </ol>
      </nav>
      <h1>Package Health Checker</h1>
      <p class="lead">
        A healthy connection delivers at least 80% of its advertised speed on a wired
        test at a quiet time. Enter your package and your measured result, this checker
        tells you whether your line is healthy, below par, or faulty. Nothing you type
        leaves your browser.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width: 720px;">
      <form id="health-form" onsubmit="return false;">
        <div class="form-group">
          <label for="type">Connection type</label>
          <select id="type">
            <option value="fibre">Fibre (Flash Fiber, Nayatel, StormFiber…)</option>
            <option value="dsl">DSL (PTCL copper line)</option>
            <option value="mobile">Mobile data (4G/5G)</option>
          </select>
        </div>
        <div class="form-group">
          <label for="package">Your package speed (Mbps)</label>
          <input id="package" type="number" min="1" max="1000" placeholder="e.g. 30" />
        </div>
        <div class="form-group">
          <label for="measured">Measured download speed (Mbps)</label>
          <input id="measured" type="number" min="0" max="1000" step="0.1" placeholder="e.g. 22.5" />
        </div>
        <div class="form-group">
          <label for="upload">Measured upload speed (Mbps), optional</label>
          <input id="upload" type="number" min="0" max="1000" step="0.1" placeholder="e.g. 8.1" />
        </div>
        <div class="form-group">
          <label for="ping">Measured ping (ms), optional</label>
          <input id="ping" type="number" min="0" max="2000" placeholder="e.g. 35" />
        </div>
        <button class="btn" type="button" id="check-btn">Check my package →</button>
      </form>

      <div id="result" style="display: none; margin-top: 2rem;">
        <h2>Your verdict</h2>
        <div class="results-grid" style="grid-template-columns: repeat(2, 1fr);">
          <div class="result-box download">
            <div class="label">Download vs package</div>
            <div class="value" id="pct-value">–</div>
          </div>
          <div class="result-box">
            <div class="label">Verdict</div>
            <div class="value" id="verdict-value" style="font-size: 1.2rem;">–</div>
          </div>
        </div>
        <div id="advice" style="margin-top: 1.2rem;"></div>
        <div class="cta-links" style="margin-top: 1.5rem;">
          <a class="btn btn-secondary" href="/tools/ptcl-complaint">Generate a complaint →</a>
          <a class="btn btn-secondary" href="/guides/troubleshoot-slow-internet">Troubleshoot →</a>
        </div>
      </div>

      <h2 style="margin-top: 2.5rem;">How to measure fairly</h2>
      <ul>
        <li><strong>Test wired</strong>: plug a laptop into the router with an Ethernet cable. Wi-Fi results don’t count for this check.</li>
        <li><strong>Test at a quiet time</strong>: early morning is best. Evening congestion can cost 20–30% even on a healthy line.</li>
        <li><strong>Test three times</strong> and use the middle result. One test can be a fluke; three tell the truth.</li>
        <li><strong>Close everything else</strong>: pause downloads, cloud backups and streams on every device before testing.</li>
      </ul>

      <h2>Frequently asked questions</h2>
      <div class="faq-list" style="margin-top: 1rem;">
        {faqs.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script>
    (function () {
      var checkBtn = document.getElementById('check-btn');
      var result = document.getElementById('result');
      var pctValue = document.getElementById('pct-value');
      var verdictValue = document.getElementById('verdict-value');
      var advice = document.getElementById('advice');

      function val(id) {
        var el = document.getElementById(id);
        return el ? el.value.trim() : '';
      }

      checkBtn.addEventListener('click', function () {
        var type = val('type');
        var pkg = parseFloat(val('package'));
        var measured = parseFloat(val('measured'));
        var upload = parseFloat(val('upload'));
        var ping = parseFloat(val('ping'));

        if (isNaN(pkg) || pkg <= 0 || isNaN(measured) || measured < 0) {
          pctValue.textContent = '–';
          verdictValue.textContent = 'Enter both speeds';
          advice.innerHTML = '<p>Enter your package speed and your measured download speed to get a verdict.</p>';
          result.style.display = 'block';
          return;
        }

        var pct = Math.round((measured / pkg) * 100);
        pctValue.textContent = pct + '%';
        var verdict, verdictAdvice;
        if (pct >= 80) {
          verdict = 'Healthy';
          verdictAdvice = '<p><strong>Your line is healthy.</strong> You are getting at least 80% of your package speed, which is what a good connection should deliver. If some devices still feel slow, the problem is Wi-Fi or the device, not the line. See our <a href="/guides/improve-wifi-signal">Wi-Fi signal guide</a>.</p>';
        } else if (pct >= 50) {
          verdict = 'Below par';
          verdictAdvice = '<p><strong>Your line is underperforming.</strong> You are getting ' + pct + '% of your package, below the 80% a healthy connection should deliver. Work through our <a href="/guides/troubleshoot-slow-internet">troubleshooter</a> first (router restart, wired test, line check), and if it stays below 80%, complain with your test results.</p>';
        } else {
          verdict = 'Poor (likely a fault)';
          verdictAdvice = '<p><strong>Your line is delivering less than half your package speed.</strong> That is a fault, not a grey area, assuming you tested wired at a quiet time. Work through the <a href="/guides/troubleshoot-slow-internet">troubleshooter</a>, then <a href="/tools/ptcl-complaint">generate a complaint</a> with these numbers.</p>';
        }
        verdictValue.textContent = verdict;

        var extra = '';
        if (!isNaN(upload)) {
          if (type === 'fibre' && upload < measured * 0.5) {
            extra += '<p><strong>Upload looks low for fibre.</strong> On a fibre line, upload should be close to download. A large gap can mean a line or configuration problem, worth mentioning in a complaint.</p>';
          } else if (type === 'dsl' && upload < 2) {
            extra += '<p><strong>Upload is normal for DSL.</strong> DSL uploads of 1–1.5 Mbps are expected even on a fast package, the copper line is the limit, not a fault.</p>';
          }
        }
        if (!isNaN(ping)) {
          if (ping < 50) {
            extra += '<p><strong>Ping is good</strong> (under 50 ms), fine for video calls and gaming.</p>';
          } else if (ping <= 100) {
            extra += '<p><strong>Ping is fair</strong> (50–100 ms), fine for browsing and calls, noticeable in fast games.</p>';
          } else {
            extra += '<p><strong>Ping is high</strong> (over 100 ms). On DSL, ask your provider about a FastPath line profile; on any connection, test wired and close background apps. See our <a href="/guides/reduce-ping-gaming">ping guide</a>.</p>';
          }
        }
        advice.innerHTML = verdictAdvice + extra;
        result.style.display = 'block';
        result.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    })();
  </script>
</BaseLayout>
