---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { comparisons } from '../../data/comparisons';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ptclspeed.example.com/' },
    { '@type': 'ListItem', position: 2, name: 'Compare Providers', item: 'https://ptclspeed.example.com/compare' },
  ],
};
---

<BaseLayout
  title="Compare Internet Providers in Pakistan — PTCL vs Nayatel, Jazz vs Zong"
  description="Head-to-head provider comparisons with published speed data: PTCL vs Nayatel, PTCL vs Transworld, Jazz vs Zong. Real averages from PTA, nPerf, Ookla and PakSpeed."
  canonical="/compare"
  schema={breadcrumbSchema}
>
  <section class="page-head">
    <div class="container">
      <p class="breadcrumbs"><a href="/">Home</a> / Compare</p>
      <h1>Compare Internet Providers</h1>
      <p class="lead">
        Head-to-head comparisons built on published measurements — PTA benchmarking,
        nPerf and Ookla scores, and community test data — with sources cited and
        disagreements shown, not hidden.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cards">
        {comparisons.map((c) => (
          <a class="card card-link" href={`/compare/${c.slug}`}>
            <h2>{c.aName} vs {c.bName}</h2>
            <p>{c.verdict}</p>
          </a>
        ))}
      </div>
      <p class="center" style="margin-top: 2rem;">
        Want the raw numbers? See our <a href="/statistics">Pakistan internet speed statistics</a> page.
      </p>
    </div>
  </section>
</BaseLayout>
