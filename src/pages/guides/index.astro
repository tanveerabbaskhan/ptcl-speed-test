<BaseLayout
  title="Internet Speed Guides — PTCL Speed Test"
  description="Plain-English guides to internet speed: understanding your speed test results, improving your PTCL connection, and what ping and jitter mean for gaming and calls."
  canonical="/guides"
>
  <section class="page-head">
    <div class="container">
      <p class="breadcrumbs"><a href="/">Home</a> / Guides</p>
      <h1>Internet Speed Guides</h1>
      <p class="lead">
        Short, practical guides — no jargon. Learn what your speed test results mean and
        how to get more out of your PTCL connection.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cards">
        {guides.map((g) => (
          <a class="card card-link" href={g.href}>
            <div class="icon">{g.icon}</div>
            <h2>{g.title}</h2>
            <p>{g.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
