---
import BaseLayout from '../../layouts/BaseLayout.astro';

const guides = [
  {
    href: '/guides/understanding-your-results',
    icon: '📊',
    title: 'Understanding Your Speed Test Results',
    desc: 'Download, upload, ping and jitter — what each number means, what counts as "good", and how much speed common activities actually need.',
  },
  {
    href: '/guides/improve-ptcl-speed',
    icon: '🚀',
    title: 'How to Improve Your PTCL Speed',
    desc: 'Ten practical fixes, from router placement to checking your line — in order of what helps most, with when to call PTCL.',
  },
  {
    href: '/guides/ping-jitter-explained',
    icon: '🎮',
    title: 'Ping & Jitter Explained',
    desc: 'Why your game lags on a "fast" connection, what good ping looks like in Pakistan, and how to lower it.',
  },
  {
    href: '/guides/ptcl-router-login',
    icon: '🔐',
    title: 'PTCL Router Login & WiFi Password Change',
    desc: 'Log in at 192.168.10.1 or 192.168.1.1, change your WiFi password from phone or laptop, and fix the login when it won\'t open.',
  },
  {
    href: '/guides/why-internet-slow-pakistan',
    icon: '🐢',
    title: 'Why Is the Internet Slow in Pakistan?',
    desc: 'From submarine cable faults to peak-hour congestion: what\'s slowing Pakistan down right now, and how to tell if it\'s your line or the network.',
  },
  {
    href: '/guides/troubleshoot-slow-internet',
    icon: '🔧',
    title: 'Slow Internet? Troubleshoot by Symptom',
    desc: 'WiFi slow but wired fast? Everything slow? Internet dropping? Find your symptom and work through the fix in order.',
  },
  {
    href: '/guides/test-speed-using-cmd',
    icon: '💻',
    title: 'How to Test Internet Speed Using CMD',
    desc: 'Check ping, packet loss and speed from Windows Command Prompt — ping, tracert and the Ookla CLI, no browser needed.',
  },
  {
    href: '/guides/ptcl-internet-slow',
    icon: '📉',
    title: 'PTCL Internet Slow? How to Fix Slow PTCL Speed',
    desc: 'Diagnose slow PTCL in order: wired test, Wi-Fi fixes, DSL line stats, fibre LOS light, and how to complain with evidence.',
  },
  {
    href: '/guides/ptcl-router-lights',
    icon: '💡',
    title: 'PTCL Router Lights Explained',
    desc: 'DSL blinking, red LOS, PON, Internet and LAN — what each light on your PTCL modem or fibre ONT means and what to do.',
  },
  {
    href: '/guides/jazz-internet-slow',
    icon: '📱',
    title: 'Jazz Internet Slow? Fix Slow Jazz 4G Speed',
    desc: 'Bundle check, airplane mode, signal, 4G-only mode, APN settings, old SIM — the Jazz fixes in order, and when to complain.',
  },
  {
    href: '/guides/jazz-apn-settings',
    icon: '⚙️',
    title: 'Jazz APN Settings & Internet Settings',
    desc: 'Get Jazz internet settings by SMS (*444*6*5#, *446*4#, or blank SMS to 7342), check your 4G SIM, and manual APN setup.',
  },
  {
    href: '/guides/reduce-ping-gaming',
    icon: '🎯',
    title: 'How to Reduce Ping for Gaming in Pakistan',
    desc: 'Lower your PUBG, Valorant and Free Fire ping: wired, nearest servers, DNS, FastPath for PTCL DSL — and what does not work.',
  },
];
---

<BaseLayout
  title="Internet Speed Guides — PTCL Speed Test"
  description="Plain-English guides to internet speed: understanding your speed test results, improving your PTCL connection, and what ping and jitter mean for gaming and calls."
  canonical="/guides"
>
  <section class="page-head">
    <div class="container">
      <p class="breadcrumbs"><a href="/">Home</a> / Guides</p>
      <h1>Internet Speed Guides</h1>
      <p class="lead">
        Short, practical guides — no jargon. Learn what your speed test results mean and
        how to get more out of your PTCL connection.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cards">
        {guides.map((g) => (
          <a class="card card-link" href={g.href}>
            <div class="icon">{g.icon}</div>
            <h2>{g.title}</h2>
            <p>{g.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
