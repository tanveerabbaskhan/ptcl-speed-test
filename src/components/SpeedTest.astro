---
/**
 * SpeedTest — a real, client-side internet speed test.
 * Measures ping, jitter, download and upload against the nearest
 * Cloudflare edge server (the same public endpoints Cloudflare's own
 * speed test uses). No account, no data leaves the browser except the
 * test traffic itself. Results history is stored in localStorage only.
 */
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<div class="speedtest-card" id="speedtest" data-compact={compact}>
  <div class="gauge-wrap">
    <svg class="gauge-svg" viewBox="0 0 320 190" role="img" aria-label="Speed gauge">
      <defs>
        <linearGradient id="gaugeGrad" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#00A9CE" />
          <stop offset="55%" stop-color="#0057A8" />
          <stop offset="100%" stop-color="#0A2540" />
        </linearGradient>
      </defs>
      <!-- track -->
      <path d="M 20 170 A 140 140 0 0 1 300 170" fill="none" stroke="#E3ECF5" stroke-width="16" stroke-linecap="round" />
      <!-- progress -->
      <path
        id="gauge-arc"
        d="M 20 170 A 140 140 0 0 1 300 170"
        fill="none"
        stroke="url(#gaugeGrad)"
        stroke-width="16"
        stroke-linecap="round"
        stroke-dasharray="440"
        stroke-dashoffset="440"
      />
      <!-- ticks -->
      <g stroke="#B9C9DA" stroke-width="2" stroke-linecap="round">
        <line x1="32" y1="170" x2="20" y2="170" />
        <line x1="49.2" y1="106" x2="38.8" y2="100" />
        <line x1="96" y1="59.2" x2="90" y2="48.8" />
        <line x1="160" y1="42" x2="160" y2="30" />
        <line x1="224" y1="59.2" x2="230" y2="48.8" />
        <line x1="270.8" y1="106" x2="281.2" y2="100" />
        <line x1="288" y1="170" x2="300" y2="170" />
      </g>
      <!-- needle -->
      <g id="gauge-needle" transform="rotate(-90 160 170)">
        <line x1="160" y1="170" x2="160" y2="58" stroke="#0A2540" stroke-width="4" stroke-linecap="round" />
      </g>
      <circle cx="160" cy="170" r="10" fill="#0A2540" />
      <circle cx="160" cy="170" r="4" fill="#fff" />
      <text x="20" y="188" font-size="11" fill="#5B6B7C" font-weight="700">0</text>
      <text x="272" y="188" font-size="11" fill="#5B6B7C" font-weight="700">1000+</text>
    </svg>
    <div class="gauge-value">
      <div>
        <span class="gauge-number" id="gauge-number">0.0</span>
        <span class="gauge-unit" id="gauge-unit">Mbps</span>
      </div>
    </div>
  </div>
  <div class="gauge-phase" id="gauge-phase">Ready when you are</div>

  <div class="test-controls">
    <button class="btn btn-lg" id="start-btn" type="button">Start Speed Test</button>
  </div>
  <div class="test-progress" aria-hidden="true">
    <div class="test-progress-bar" id="progress-bar"></div>
  </div>

  <div class="results-grid" id="results-grid">
    <div class="result-box download">
      <div class="label">Download</div>
      <div class="value" id="res-download">–</div>
      <div class="unit">Mbps</div>
    </div>
    <div class="result-box upload">
      <div class="label">Upload</div>
      <div class="value" id="res-upload">–</div>
      <div class="unit">Mbps</div>
    </div>
    <div class="result-box">
      <div class="label">Ping</div>
      <div class="value" id="res-ping">–</div>
      <div class="unit">ms</div>
    </div>
    <div class="result-box">
      <div class="label">Jitter</div>
      <div class="value" id="res-jitter">–</div>
      <div class="unit">ms</div>
    </div>
  </div>

  <div class="verdict" id="verdict" hidden></div>
  <div class="test-error" id="test-error" hidden></div>

  <div class="history-actions" id="result-actions" hidden>
    <button class="btn btn-outline btn-small" id="copy-btn" type="button">Copy result</button>
    <button class="btn btn-outline btn-small" id="retest-btn" type="button">Test again</button>
  </div>

  <p class="server-meta" id="server-meta">
    Test server: nearest Cloudflare edge · Your IP: detecting…
  </p>

  <div class="history" id="history" hidden>
    <h4>Your recent tests on this device</h4>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Date</th><th>Download</th><th>Upload</th><th>Ping</th><th>Jitter</th></tr>
        </thead>
        <tbody id="history-body"></tbody>
      </table>
    </div>
    <button class="btn btn-outline btn-small" id="clear-history-btn" type="button">Clear history</button>
  </div>
</div>

<script>
  const DOWN_URL = 'https://speed.cloudflare.com/__down';
  const UP_URL = 'https://speed.cloudflare.com/__up';
  const META_URL = 'https://speed.cloudflare.com/meta';
  const HISTORY_KEY = 'ptcl-speed-history';
  const MAX_GAUGE_MBPS = 1000;

  const $ = (id) => document.getElementById(id);
  const gaugeArc = $('gauge-arc');
  const gaugeNeedle = $('gauge-needle');
  const gaugeNumber = $('gauge-number');
  const gaugeUnit = $('gauge-unit');
  const gaugePhase = $('gauge-phase');
  const startBtn = $('start-btn');
  const progressBar = $('progress-bar');
  const verdictEl = $('verdict');
  const errorEl = $('test-error');
  const resultActions = $('result-actions');
  const serverMeta = $('server-meta');
  const historyEl = $('history');
  const historyBody = $('history-body');

  let running = false;
  let stopFlag = false;

  /** Map Mbps to a 0–1 gauge fraction on a log scale (0–1000 Mbps). */
  function toFraction(mbps) {
    if (mbps <= 0) return 0;
    return Math.min(1, Math.log10(mbps + 1) / Math.log10(MAX_GAUGE_MBPS + 1));
  }

  function setGauge(mbps) {
    const f = toFraction(mbps);
    gaugeArc.style.strokeDashoffset = String(440 * (1 - f));
    gaugeNeedle.setAttribute('transform', `rotate(${-90 + 180 * f} 160 170)`);
  }

  function setPhase(text) {
    gaugePhase.textContent = text;
  }

  function setProgress(pct) {
    progressBar.style.width = `${Math.min(100, Math.max(0, pct))}%`;
  }

  function showError(msg) {
    errorEl.hidden = false;
    errorEl.textContent = msg;
  }

  function hideError() {
    errorEl.hidden = true;
    errorEl.textContent = '';
  }

  function verdictFor(down, ping) {
    if (down < 4)
      return '<strong>Basic only.</strong> Fine for browsing and email, but video calls and HD streaming will struggle. If you pay for more than this, see our <a href="/guides/improve-ptcl-speed">guide to improving PTCL speed</a>.';
    if (down < 10)
      return '<strong>Good for everyday use.</strong> HD video, browsing and video calls work well. 4K streaming and big downloads will feel slow.';
    if (down < 25)
      return '<strong>Great for most homes.</strong> Full HD streaming, smooth video calls and online classes on a couple of devices at once.';
    if (down < 50)
      return '<strong>Excellent.</strong> 4K streaming, fast downloads and gaming all work comfortably, even with several people online.';
    if (down < 100)
      return '<strong>Excellent — plenty of headroom.</strong> 4K on multiple screens, big game downloads and video calls at the same time.';
    const pingNote = ping <= 30 ? ' Low ping too, so online gaming should feel responsive.' : '';
    return `<strong>Outstanding.</strong> A very fast connection — good for anything a home or small office can throw at it.${pingNote}`;
  }

  function loadHistory() {
    try {
      return JSON.parse(localStorage.getItem(HISTORY_KEY) || '[]');
    } catch {
      return [];
    }
  }

  function renderHistory() {
    const items = loadHistory();
    if (!items.length) {
      historyEl.hidden = true;
      return;
    }
    historyEl.hidden = false;
    historyBody.innerHTML = items
      .slice(0, 5)
      .map(
        (h) =>
          `<tr><td>${h.date}</td><td>${h.down} Mbps</td><td>${h.up} Mbps</td><td>${h.ping} ms</td><td>${h.jitter} ms</td></tr>`
      )
      .join('');
  }

  function saveResult(result) {
    const items = loadHistory();
    items.unshift({
      date: new Date().toLocaleString('en-PK', { dateStyle: 'medium', timeStyle: 'short' }),
      ...result,
    });
    try {
      localStorage.setItem(HISTORY_KEY, JSON.stringify(items.slice(0, 10)));
    } catch {
      /* storage unavailable — ignore */
    }
    renderHistory();
  }

  async function detectServer() {
    try {
      const res = await fetch(META_URL, { cache: 'no-store' });
      const meta = await res.json();
      serverMeta.textContent = meta.clientIp
        ? `Test server: nearest Cloudflare edge · Your IP: ${meta.clientIp}`
        : 'Test server: nearest Cloudflare edge';
    } catch {
      serverMeta.textContent = 'Test server: nearest Cloudflare edge';
    }
  }

  async function measurePing(samples = 8) {
    const times = [];
    for (let i = 0; i < samples; i++) {
      if (stopFlag) break;
      const t0 = performance.now();
      await fetch(`${DOWN_URL}?bytes=0&r=${Math.random()}`, { cache: 'no-store' });
      times.push(performance.now() - t0);
      setProgress(2 + (i / samples) * 8);
      await new Promise((r) => setTimeout(r, 60));
    }
    const ping = Math.min(...times);
    let jitter = 0;
    if (times.length > 1) {
      let sum = 0;
      for (let i = 1; i < times.length; i++) sum += Math.abs(times[i] - times[i - 1]);
      jitter = sum / (times.length - 1);
    }
    return { ping, jitter };
  }

  async function measureDownload(durationMs = 9000, streams = 4) {
    let bytes = 0;
    let active = true;
    const worker = async () => {
      while (active && !stopFlag) {
        try {
          const res = await fetch(`${DOWN_URL}?bytes=25000000&r=${Math.random()}`, { cache: 'no-store' });
          const reader = res.body.getReader();
          for (;;) {
            const { done, value } = await reader.read();
            if (done) break;
            bytes += value.byteLength;
            if (!active || stopFlag) {
              try { await reader.cancel(); } catch { /* noop */ }
              break;
            }
          }
        } catch {
          break;
        }
      }
    };
    const workers = Array.from({ length: streams }, () => worker());

    // Warm-up, then measure over the remaining window.
    await new Promise((r) => setTimeout(r, 1000));
    const t0 = performance.now();
    const b0 = bytes;
    const sampler = setInterval(() => {
      const elapsed = (performance.now() - t0) / 1000;
      if (elapsed > 0.5) {
        const mbps = ((bytes - b0) * 8) / (elapsed * 1e6);
        gaugeNumber.textContent = mbps.toFixed(1);
        setGauge(mbps);
      }
      setProgress(10 + ((performance.now() - t0) / (durationMs - 1000)) * 50);
    }, 200);

    await new Promise((r) => setTimeout(r, durationMs - 1000));
    const t1 = performance.now();
    const b1 = bytes;
    clearInterval(sampler);
    active = false;
    await Promise.allSettled(workers);
    return ((b1 - b0) * 8) / (((t1 - t0) / 1000) * 1e6);
  }

  async function measureUpload(durationMs = 7000, streams = 3) {
    const payload = new Uint8Array(256 * 1024);
    crypto.getRandomValues(payload);
    let bytes = 0;
    let active = true;
    const worker = async () => {
      while (active && !stopFlag) {
        try {
          await fetch(UP_URL, { method: 'POST', body: payload, cache: 'no-store' });
          bytes += payload.byteLength;
        } catch {
          break;
        }
      }
    };
    const workers = Array.from({ length: streams }, () => worker());

    await new Promise((r) => setTimeout(r, 1000));
    const t0 = performance.now();
    const b0 = bytes;
    const sampler = setInterval(() => {
      const elapsed = (performance.now() - t0) / 1000;
      if (elapsed > 0.5) {
        const mbps = ((bytes - b0) * 8) / (elapsed * 1e6);
        gaugeNumber.textContent = mbps.toFixed(1);
        setGauge(mbps);
      }
      setProgress(60 + ((performance.now() - t0) / (durationMs - 1000)) * 35);
    }, 200);

    await new Promise((r) => setTimeout(r, durationMs - 1000));
    const t1 = performance.now();
    const b1 = bytes;
    clearInterval(sampler);
    active = false;
    await Promise.allSettled(workers);
    return ((b1 - b0) * 8) / (((t1 - t0) / 1000) * 1e6);
  }

  async function runTest() {
    if (running) return;
    running = true;
    stopFlag = false;
    hideError();
    verdictEl.hidden = true;
    resultActions.hidden = true;
    startBtn.disabled = true;
    startBtn.textContent = 'Testing…';
    gaugeUnit.textContent = 'Mbps';
    for (const id of ['res-download', 'res-upload', 'res-ping', 'res-jitter']) $(id).textContent = '–';

    try {
      setPhase('Measuring ping');
      setProgress(2);
      const { ping, jitter } = await measurePing();
      $('res-ping').textContent = ping.toFixed(0);
      $('res-jitter').textContent = jitter.toFixed(0);
      gaugeNumber.textContent = ping.toFixed(0);
      gaugeUnit.textContent = 'ms ping';
      setGauge(0);
      setProgress(10);

      setPhase('Measuring download');
      gaugeUnit.textContent = 'Mbps';
      const down = await measureDownload();
      $('res-download').textContent = down.toFixed(1);
      gaugeNumber.textContent = down.toFixed(1);
      setGauge(down);
      setProgress(60);

      setPhase('Measuring upload');
      const up = await measureUpload();
      $('res-upload').textContent = up.toFixed(1);
      gaugeNumber.textContent = up.toFixed(1);
      setGauge(up);
      setProgress(96);

      setPhase('Complete');
      setProgress(100);
      const result = {
        down: down.toFixed(1),
        up: up.toFixed(1),
        ping: ping.toFixed(0),
        jitter: jitter.toFixed(0),
      };
      verdictEl.innerHTML = verdictFor(down, ping);
      verdictEl.hidden = false;
      resultActions.hidden = false;
      saveResult(result);
    } catch (err) {
      console.error(err);
      showError(
        'The test could not reach the test server. Check your internet connection and try again — if you use a VPN, ad-blocker or firewall, it may be blocking the test.'
      );
      setPhase('Test failed');
    } finally {
      running = false;
      startBtn.disabled = false;
      startBtn.textContent = 'Start Speed Test';
    }
  }

  startBtn.addEventListener('click', runTest);
  $('retest-btn')?.addEventListener('click', runTest);
  $('copy-btn')?.addEventListener('click', async () => {
    const text = `My internet speed: ${$('res-download').textContent} Mbps down / ${$('res-upload').textContent} Mbps up, ping ${$('res-ping').textContent} ms, jitter ${$('res-jitter').textContent} ms — tested at PTCL Speed Test`;
    try {
      await navigator.clipboard.writeText(text);
      $('copy-btn').textContent = 'Copied!';
      setTimeout(() => { $('copy-btn').textContent = 'Copy result'; }, 2000);
    } catch {
      showError('Could not copy automatically — select the numbers above to copy them manually.');
    }
  });
  $('clear-history-btn')?.addEventListener('click', () => {
    try { localStorage.removeItem(HISTORY_KEY); } catch { /* noop */ }
    renderHistory();
  });

  renderHistory();
  detectServer();
</script>
