---
/**
 * SpeedTest – a real, client-side internet speed test.
 * Measures ping, jitter, download and upload against the nearest
 * Cloudflare edge server (the same public endpoints Cloudflare's own
 * speed test uses). No account, no data leaves the browser except the
 * test traffic itself. Results history is stored in localStorage only.
 *
 * Modes: 'full' runs every phase; 'ping' measures ping and jitter only;
 * 'jitter' measures ping and jitter with more samples; 'upload' measures
 * ping briefly, then upload only.
 */
interface Props {
  compact?: boolean;
  mode?: 'full' | 'ping' | 'jitter' | 'upload';
}
const { compact = false, mode = 'full' } = Astro.props;

const startLabels: Record<string, string> = {
  full: 'Start Speed Test',
  ping: 'Start Ping Test',
  jitter: 'Start Jitter Test',
  upload: 'Start Upload Test',
};
---

<div class="speedtest-card" id="speedtest" data-compact={compact} data-mode={mode}>
  <div class="gauge-wrap">
    <svg class="gauge-svg" viewBox="0 0 320 190" role="img" aria-label="Speed gauge">
      <defs>
        <linearGradient id="gaugeGrad" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#00A9CE" />
          <stop offset="55%" stop-color="#0057A8" />
          <stop offset="100%" stop-color="#0A2540" />
        </linearGradient>
      </defs>
      <!-- track -->
      <path d="M 20 170 A 140 140 0 0 1 300 170" fill="none" stroke="#E3ECF5" stroke-width="16" stroke-linecap="round" />
      <!-- progress -->
      <path
        id="gauge-arc"
        d="M 20 170 A 140 140 0 0 1 300 170"
        fill="none"
        stroke="url(#gaugeGrad)"
        stroke-width="16"
        stroke-linecap="round"
        stroke-dasharray="440"
        stroke-dashoffset="440"
      />
      <!-- ticks -->
      <g stroke="#B9C9DA" stroke-width="2" stroke-linecap="round">
        <line x1="32" y1="170" x2="20" y2="170" />
        <line x1="49.2" y1="106" x2="38.8" y2="100" />
        <line x1="96" y1="59.2" x2="90" y2="48.8" />
        <line x1="160" y1="42" x2="160" y2="30" />
        <line x1="224" y1="59.2" x2="230" y2="48.8" />
        <line x1="270.8" y1="106" x2="281.2" y2="100" />
        <line x1="288" y1="170" x2="300" y2="170" />
      </g>
      <!-- needle -->
      <g id="gauge-needle" transform="rotate(-90 160 170)">
        <line x1="160" y1="170" x2="160" y2="58" stroke="#0A2540" stroke-width="4" stroke-linecap="round" />
      </g>
      <circle cx="160" cy="170" r="10" fill="#0A2540" />
      <circle cx="160" cy="170" r="4" fill="#fff" />
      <text x="20" y="188" font-size="11" fill="#5B6B7C" font-weight="700">0</text>
      <text x="272" y="188" font-size="11" fill="#5B6B7C" font-weight="700">1000+</text>
    </svg>
    <div class="gauge-value">
      <div>
        <span class="gauge-number" id="gauge-number">0.0</span>
        <span class="gauge-unit" id="gauge-unit">Mbps</span>
      </div>
    </div>
  </div>
  <div class="gauge-phase" id="gauge-phase">Ready when you are</div>

  <div class="test-controls">
    <button class="btn btn-lg" id="start-btn" type="button">{startLabels[mode]}</button>
  </div>
  <div class="test-progress" aria-hidden="true">
    <div class="test-progress-bar" id="progress-bar"></div>
  </div>

  <div class="results-grid" id="results-grid">
    <div class="result-box download" id="box-download">
      <div class="label">Download</div>
      <div class="value" id="res-download">–</div>
      <div class="unit">Mbps</div>
    </div>
    <div class="result-box upload" id="box-upload">
      <div class="label">Upload</div>
      <div class="value" id="res-upload">–</div>
      <div class="unit">Mbps</div>
    </div>
    <div class="result-box" id="box-ping">
      <div class="label">Ping</div>
      <div class="value" id="res-ping">–</div>
      <div class="unit">ms</div>
    </div>
    <div class="result-box" id="box-jitter">
      <div class="label">Jitter</div>
      <div class="value" id="res-jitter">–</div>
      <div class="unit">ms</div>
    </div>
  </div>

  <div class="mascot" id="mascot">
    <svg class="mascot-svg" viewBox="0 0 200 200" role="img" aria-label="Marky the markhor, our mascot">
      <!-- speed lines (sprint only) -->
      <g id="mascot-lines" stroke="#00A9CE" stroke-width="5" stroke-linecap="round" style="display: none;">
        <line x1="6" y1="100" x2="38" y2="100" />
        <line x1="2" y1="124" x2="32" y2="124" />
        <line x1="10" y1="148" x2="38" y2="148" />
        <line x1="162" y1="100" x2="194" y2="100" />
        <line x1="168" y1="124" x2="198" y2="124" />
        <line x1="162" y1="148" x2="190" y2="148" />
      </g>
      <!-- horns -->
      <g fill="none" stroke="#D9C7A7" stroke-width="15" stroke-linecap="round">
        <path d="M 70 96 C 50 82, 38 60, 46 38 C 50 26, 62 22, 68 30" />
        <path d="M 130 96 C 150 82, 162 60, 154 38 C 150 26, 138 22, 132 30" />
      </g>
      <g stroke="#B39B73" stroke-width="3" stroke-linecap="round">
        <line x1="40" y1="58" x2="52" y2="50" />
        <line x1="42" y1="44" x2="54" y2="38" />
        <line x1="160" y1="58" x2="148" y2="50" />
        <line x1="158" y1="44" x2="146" y2="38" />
      </g>
      <!-- ears -->
      <ellipse cx="50" cy="122" rx="13" ry="9" fill="#A06B3F" transform="rotate(-25 50 122)" />
      <ellipse cx="50" cy="122" rx="7" ry="4.5" fill="#E8C9A0" transform="rotate(-25 50 122)" />
      <ellipse cx="150" cy="122" rx="13" ry="9" fill="#A06B3F" transform="rotate(25 150 122)" />
      <ellipse cx="150" cy="122" rx="7" ry="4.5" fill="#E8C9A0" transform="rotate(25 150 122)" />
      <!-- head -->
      <ellipse cx="100" cy="122" rx="55" ry="52" fill="#B07D4F" />
      <ellipse cx="100" cy="140" rx="36" ry="28" fill="#E8C9A0" />
      <!-- beard -->
      <path d="M 88 170 Q 100 192 112 170 Q 106 178 100 176 Q 94 178 88 170 Z" fill="#8B5E3C" />
      <!-- brows -->
      <g id="mascot-brows-flat" stroke="#8B5E3C" stroke-width="4" stroke-linecap="round">
        <line x1="70" y1="100" x2="88" y2="100" />
        <line x1="112" y1="100" x2="130" y2="100" />
      </g>
      <g id="mascot-brows-raised" stroke="#8B5E3C" stroke-width="4" stroke-linecap="round" fill="none" style="display: none;">
        <path d="M 70 100 Q 79 93 88 99" />
        <path d="M 112 99 Q 121 93 130 100" />
      </g>
      <!-- eyes: open -->
      <g id="mascot-eyes-open">
        <circle cx="80" cy="114" r="7.5" fill="#2B1A0E" />
        <circle cx="120" cy="114" r="7.5" fill="#2B1A0E" />
        <circle cx="82.5" cy="111.5" r="2.5" fill="#fff" />
        <circle cx="122.5" cy="111.5" r="2.5" fill="#fff" />
      </g>
      <!-- eyes: closed (asleep) -->
      <g id="mascot-eyes-closed" stroke="#2B1A0E" stroke-width="3.5" stroke-linecap="round" fill="none" style="display: none;">
        <path d="M 72 114 Q 80 121 88 114" />
        <path d="M 112 114 Q 120 121 128 114" />
      </g>
      <!-- eyes: happy -->
      <g id="mascot-eyes-happy" stroke="#2B1A0E" stroke-width="3.5" stroke-linecap="round" fill="none" style="display: none;">
        <path d="M 72 116 Q 80 107 88 116" />
        <path d="M 112 116 Q 120 107 128 116" />
      </g>
      <!-- sunglasses (sprint only) -->
      <g id="mascot-shades" style="display: none;">
        <rect x="66" y="104" width="30" height="19" rx="8" fill="#0A2540" />
        <rect x="104" y="104" width="30" height="19" rx="8" fill="#0A2540" />
        <rect x="94" y="110" width="12" height="5" rx="2" fill="#0A2540" />
        <g stroke="#fff" stroke-width="2.5" stroke-linecap="round" opacity="0.7">
          <line x1="72" y1="118" x2="80" y2="108" />
          <line x1="110" y1="118" x2="118" y2="108" />
        </g>
      </g>
      <!-- nose -->
      <ellipse cx="100" cy="140" rx="9" ry="6.5" fill="#5C3A21" />
      <!-- mouth: small smile -->
      <path id="mascot-mouth-smile" d="M 86 154 Q 100 162 114 154" stroke="#5C3A21" stroke-width="3" stroke-linecap="round" fill="none" />
      <!-- mouth: open smile -->
      <path id="mascot-mouth-open" d="M 86 152 Q 100 172 114 152 Z" fill="#7A3B2E" style="display: none;" />
      <!-- Zzz (asleep only) -->
      <g id="mascot-zzz" class="mascot-zzz" fill="#5B6B7C" font-weight="700" font-family="inherit" style="display: none;">
        <text x="148" y="66" font-size="24">Z</text>
        <text x="162" y="46" font-size="17">Z</text>
        <text x="174" y="30" font-size="12">Z</text>
      </g>
    </svg>
    <p class="mascot-name">Marky the markhor</p>
    <p class="mascot-caption" id="mascot-caption">Marky is waiting. Press start when you are ready.</p>
  </div>

  <div class="verdict" id="verdict" hidden></div>
  <div class="test-error" id="test-error" hidden></div>

  <div class="history-actions" id="result-actions" hidden>
    <button class="btn btn-outline btn-small" id="copy-btn" type="button">Copy result</button>
    <button class="btn btn-outline btn-small" id="roast-btn" type="button">Roast my speed</button>
    <button class="btn btn-outline btn-small" id="retest-btn" type="button">Test again</button>
  </div>

  <div class="roast-card" id="roast-card" hidden>
    <p class="roast-label">Your roast, ready to share</p>
    <p class="roast-text" id="roast-text"></p>
    <div class="roast-actions">
      <button class="btn btn-outline btn-small" id="roast-copy-btn" type="button">Copy for WhatsApp</button>
      <a class="btn btn-outline btn-small" id="roast-wa-link" href="#" target="_blank" rel="noopener">Share on WhatsApp</a>
    </div>
    <p class="small muted roast-status" id="roast-status"></p>
  </div>

  <p class="server-meta" id="server-meta">
    Test server: nearest Cloudflare edge · Your IP: detecting…
  </p>

  <div class="history" id="history" hidden>
    <p class="history-title">Your recent tests on this device</p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th scope="col">Date</th><th scope="col">Download</th><th scope="col">Upload</th><th scope="col">Ping</th><th scope="col">Jitter</th></tr>
        </thead>
        <tbody id="history-body"></tbody>
      </table>
    </div>
    <button class="btn btn-outline btn-small" id="clear-history-btn" type="button">Clear history</button>
  </div>
</div>

<script>
  const DOWN_URL = 'https://speed.cloudflare.com/__down';
  const UP_URL = 'https://speed.cloudflare.com/__up';
  const META_URL = 'https://speed.cloudflare.com/meta';
  const SITE_URL = 'https://ptcl-speed-test.pages.dev';
  const HISTORY_KEY = 'ptcl-speed-history';
  const MAX_GAUGE_MBPS = 1000;

  const $ = (id) => document.getElementById(id);
  const mode = ($('speedtest').dataset.mode || 'full');
  const startLabel = { full: 'Start Speed Test', ping: 'Start Ping Test', jitter: 'Start Jitter Test', upload: 'Start Upload Test' }[mode] || 'Start Speed Test';
  const gaugeArc = $('gauge-arc');
  const gaugeNeedle = $('gauge-needle');
  const gaugeNumber = $('gauge-number');
  const gaugeUnit = $('gauge-unit');
  const gaugePhase = $('gauge-phase');
  const startBtn = $('start-btn');
  const progressBar = $('progress-bar');
  const verdictEl = $('verdict');
  const errorEl = $('test-error');
  const resultActions = $('result-actions');
  const serverMeta = $('server-meta');
  const historyEl = $('history');
  const historyBody = $('history-body');
  const resultsGrid = $('results-grid');
  const mascotCaption = $('mascot-caption');
  const roastCard = $('roast-card');
  const roastTextEl = $('roast-text');
  const roastStatus = $('roast-status');
  const roastWaLink = $('roast-wa-link');

  let running = false;
  let stopFlag = false;
  let lastNumbers = null; // { down, up, ping, jitter } in numbers, or null when unmeasured

  // Hide result boxes this mode never measures, and size the grid to fit.
  if (mode === 'ping' || mode === 'jitter') {
    $('box-download').style.display = 'none';
    $('box-upload').style.display = 'none';
    resultsGrid.style.gridTemplateColumns = 'repeat(2, 1fr)';
  } else if (mode === 'upload') {
    $('box-download').style.display = 'none';
    resultsGrid.style.gridTemplateColumns = 'repeat(3, 1fr)';
  }

  /** Map Mbps to a 0–1 gauge fraction on a log scale (0–1000 Mbps). */
  function toFraction(mbps) {
    if (mbps <= 0) return 0;
    return Math.min(1, Math.log10(mbps + 1) / Math.log10(MAX_GAUGE_MBPS + 1));
  }

  function setGauge(mbps) {
    const f = toFraction(mbps);
    gaugeArc.style.strokeDashoffset = String(440 * (1 - f));
    gaugeNeedle.setAttribute('transform', `rotate(${-90 + 180 * f} 160 170)`);
  }

  function setPhase(text) {
    gaugePhase.textContent = text;
  }

  function setProgress(pct) {
    progressBar.style.width = `${Math.min(100, Math.max(0, pct))}%`;
  }

  function showError(msg) {
    errorEl.hidden = false;
    errorEl.textContent = msg;
  }

  function hideError() {
    errorEl.hidden = true;
    errorEl.textContent = '';
  }

  /* Marky the markhor: the mascot reacts to the result. */
  const MASCOT_MOODS = {
    idle: { eyes: 'open', mouth: 'smile', brows: 'flat', zzz: false, lines: false, shades: false, caption: 'Marky is waiting. Press start when you are ready.' },
    sleep: { eyes: 'closed', mouth: 'smile', brows: 'flat', zzz: true, lines: false, shades: false, caption: 'Marky fell asleep waiting for your internet.' },
    smile: { eyes: 'open', mouth: 'open', brows: 'raised', zzz: false, lines: false, shades: false, caption: 'Marky is strolling. Your internet is getting there.' },
    happy: { eyes: 'happy', mouth: 'open', brows: 'raised', zzz: false, lines: false, shades: false, caption: 'Marky approves. That is a solid connection.' },
    sprint: { eyes: 'happy', mouth: 'open', brows: 'raised', zzz: false, lines: true, shades: true, caption: 'Marky cannot keep up with your internet.' },
    fail: { eyes: 'closed', mouth: 'smile', brows: 'flat', zzz: false, lines: false, shades: false, caption: 'Marky could not reach the test server either.' },
  };

  function setMascot(moodName) {
    const m = MASCOT_MOODS[moodName] || MASCOT_MOODS.idle;
    const show = (id, on) => { const el = $(id); if (el) el.style.display = on ? '' : 'none'; };
    show('mascot-eyes-open', m.eyes === 'open');
    show('mascot-eyes-closed', m.eyes === 'closed');
    show('mascot-eyes-happy', m.eyes === 'happy' && !m.shades);
    show('mascot-brows-flat', m.brows === 'flat');
    show('mascot-brows-raised', m.brows === 'raised');
    show('mascot-mouth-smile', m.mouth === 'smile');
    show('mascot-mouth-open', m.mouth === 'open');
    show('mascot-zzz', m.zzz);
    show('mascot-lines', m.lines);
    show('mascot-shades', m.shades);
    mascotCaption.textContent = m.caption;
  }

  function speedMood(mbps) {
    if (mbps === null || mbps === undefined || isNaN(mbps)) return 'idle';
    if (mbps < 4) return 'sleep';
    if (mbps < 10) return 'smile';
    if (mbps < 100) return 'happy';
    return 'sprint';
  }

  function moodFor(numbers) {
    if (mode === 'ping') {
      const p = numbers.ping;
      if (p === null || p === undefined) return 'idle';
      if (p < 30) return 'sprint';
      if (p < 50) return 'happy';
      if (p < 100) return 'smile';
      return 'sleep';
    }
    if (mode === 'jitter') {
      const j = numbers.jitter;
      if (j === null || j === undefined) return 'idle';
      if (j < 10) return 'sprint';
      if (j < 30) return 'happy';
      if (j < 50) return 'smile';
      return 'sleep';
    }
    if (mode === 'upload') return speedMood(numbers.up);
    return speedMood(numbers.down);
  }

  /* Roast my speed: a funny, shareable one-liner built from the result. */
  function pick(arr) {
    return arr[Math.floor(Math.random() * arr.length)];
  }

  function roastJoke(numbers) {
    if (mode === 'ping') {
      const p = numbers.ping;
      if (p < 30) return pick([`My ping is ${p} ms. My game character moves before I even think.`, `My ping is ${p} ms. Basically telepathy.`]);
      if (p < 50) return pick([`My ping is ${p} ms. Good enough for ranked games and smooth calls.`, `My ping is ${p} ms. No excuses left for losing.`]);
      if (p < 100) return pick([`My ping is ${p} ms. Playable, but my character sometimes teleports.`, `My ping is ${p} ms. My calls are fine, my games are suspicious.`]);
      return pick([`My ping is ${p} ms. I press jump, my character jumps next week.`, `My ping is ${p} ms. My game is buffering my reflexes.`]);
    }
    if (mode === 'jitter') {
      const j = numbers.jitter;
      if (j < 10) return pick([`My jitter is ${j} ms. Rock steady, calls never stutter.`, `My jitter is ${j} ms. Steadier than my sleep schedule.`]);
      if (j < 30) return pick([`My jitter is ${j} ms. Steady enough for smooth calls.`, `My jitter is ${j} ms. My ping behaves itself.`]);
      if (j < 50) return pick([`My jitter is ${j} ms. My voice breaks up just when the joke lands.`, `My jitter is ${j} ms. My ping has commitment issues.`]);
      return pick([`My jitter is ${j} ms. My ping jumps around more than a goat on a mountain.`, `My jitter is ${j} ms. My connection cannot decide how fast it is.`]);
    }
    if (mode === 'upload') {
      const u = numbers.up;
      if (u < 2) return pick([`My upload is ${u} Mbps. My video freezes, my backups crawl, my DSL is doing its best.`, `My upload is ${u} Mbps. Sending a photo takes longer than taking it.`]);
      if (u < 10) return pick([`My upload is ${u} Mbps. Calls work, backups take the scenic route.`, `My upload is ${u} Mbps. Fine for calls, hopeless for cloud backups.`]);
      if (u < 25) return pick([`My upload is ${u} Mbps. Backups and video calls, no drama.`, `My upload is ${u} Mbps. My files actually arrive.`]);
      return pick([`My upload is ${u} Mbps. I could livestream from the roof.`, `My upload is ${u} Mbps. Backups finish before my chai gets cold.`]);
    }
    const d = numbers.down;
    if (d < 4) return pick([`My internet is officially a tortoise: ${d} Mbps down. Even the markhor fell asleep.`, `My internet moves like Lahore traffic on a rainy Friday: ${d} Mbps down. Send help (and fibre).`]);
    if (d < 10) return pick([`My internet runs on one bar of signal and pure hope: ${d} Mbps down.`, `My internet can do WhatsApp. 4K? Let us not talk about it. ${d} Mbps down.`]);
    if (d < 25) return pick([`My internet is decent, like a rickshaw with a new engine: ${d} Mbps down.`, `My internet finally behaves most days: ${d} Mbps down.`]);
    if (d < 50) return pick([`My internet is solid: ${d} Mbps down. The buffering uncle has left the building.`, `4K streams, no freezes, no drama: ${d} Mbps down. My internet grew up.`]);
    if (d < 100) return pick([`My internet is fast enough to make the neighbours jealous: ${d} Mbps down.`, `Downloads finish before my chai gets cold: ${d} Mbps down.`]);
    return pick([`My internet is faster than gossip in a Lahori drawing room: ${d} Mbps down.`, `Fibre flex: ${d} Mbps down. The markhor cannot keep up.`]);
  }

  function buildRoast(numbers) {
    const joke = roastJoke(numbers);
    const extras = [];
    if (mode === 'full') {
      if (numbers.up !== null && numbers.up !== undefined) extras.push(`upload ${numbers.up} Mbps`);
      if (numbers.ping !== null && numbers.ping !== undefined) extras.push(`ping ${numbers.ping} ms`);
    } else if (mode === 'ping' || mode === 'jitter') {
      const other = mode === 'ping' ? numbers.jitter : numbers.ping;
      const label = mode === 'ping' ? 'jitter' : 'ping';
      if (other !== null && other !== undefined) extras.push(`${label} ${other} ms`);
    } else if (mode === 'upload') {
      if (numbers.ping !== null && numbers.ping !== undefined) extras.push(`ping ${numbers.ping} ms`);
    }
    const extraText = extras.length ? ` ${extras[0].charAt(0).toUpperCase() + extras[0].slice(1)}${extras.length > 1 ? `, ${extras.slice(1).join(', ')}` : ''}.` : '';
    return `${joke}${extraText} Test yours: ${SITE_URL}`;
  }

  async function copyText(text, statusEl, doneMsg) {
    try {
      await navigator.clipboard.writeText(text);
      if (statusEl) statusEl.textContent = doneMsg;
      return true;
    } catch {
      if (statusEl) statusEl.textContent = 'Copy did not work in this browser. Select the text above to copy it manually.';
      return false;
    }
  }

  function verdictFor(down, ping) {
    if (down < 4)
      return '<strong>Basic only.</strong> Fine for browsing and email, but video calls and HD streaming will struggle. If you pay for more than this, see our <a href="/guides/improve-ptcl-speed">guide to improving PTCL speed</a>.';
    if (down < 10)
      return '<strong>Good for everyday use.</strong> HD video, browsing and video calls work well. 4K streaming and big downloads will feel slow.';
    if (down < 25)
      return '<strong>Great for most homes.</strong> Full HD streaming, smooth video calls and online classes on a couple of devices at once.';
    if (down < 50)
      return '<strong>Excellent.</strong> 4K streaming, fast downloads and gaming all work comfortably, even with several people online.';
    if (down < 100)
      return '<strong>Excellent, with plenty of headroom.</strong> 4K on multiple screens, big game downloads and video calls at the same time.';
    const pingNote = ping <= 30 ? ' Low ping too, so online gaming should feel responsive.' : '';
    return `<strong>Outstanding.</strong> A very fast connection, good for anything a home or small office can throw at it.${pingNote}`;
  }

  function pingVerdict(ping) {
    if (ping < 30)
      return '<strong>Excellent ping.</strong> Under 30 ms is ideal for competitive gaming and video calls. Your connection responds almost instantly.';
    if (ping < 50)
      return '<strong>Good ping.</strong> Fine for gaming and video calls. If you play competitively, a wired connection and the nearest server (Dubai or Singapore) can shave a few ms off.';
    if (ping < 100)
      return '<strong>Fair ping.</strong> Browsing and calls are fine, but you will notice lag in fast games. Try a wired connection and the nearest game server. See our <a href="/guides/reduce-ping-gaming">guide to reducing ping</a>.';
    return '<strong>High ping.</strong> Over 100 ms means delayed calls and laggy games. Test wired, close background downloads, and check whether your connection is routed to a faraway server. See our <a href="/guides/reduce-ping-gaming">guide to reducing ping</a>.';
  }

  function jitterVerdict(jitter, ping) {
    if (jitter < 10)
      return '<strong>Rock-steady connection.</strong> Jitter under 10 ms means calls stay smooth and games never stutter.';
    if (jitter < 30)
      return '<strong>Good jitter.</strong> Your ping is steady enough for smooth calls and gaming.';
    if (jitter < 50)
      return '<strong>Noticeable jitter.</strong> You may hear voice breaking up on calls and feel the odd stutter in games. A wired connection usually steadies it, so test over Ethernet if you tested on Wi-Fi.';
    return '<strong>High jitter.</strong> Your ping jumps around too much for smooth calls and gaming, even if the average ping looks fine. Test wired, close background downloads, and if it stays high, ask your provider to check the line.';
  }

  function uploadVerdict(up, ping) {
    if (up < 2)
      return '<strong>Typical DSL upload.</strong> Uploads of 1–1.5 Mbps are normal on a copper DSL line, and they are the reason video freezes on calls. The real fix is fibre, where uploads run close to downloads.';
    if (up < 10)
      return '<strong>Good enough for calls.</strong> Video calls and sending files work fine, but cloud backups and large uploads will crawl.';
    if (up < 25)
      return '<strong>Solid upload.</strong> Group video calls, cloud backups and large file uploads all work comfortably.';
    return '<strong>Excellent upload.</strong> Fast enough for livestreaming, big backups and heavy uploads without slowing anything else down.';
  }

  function loadHistory() {
    try {
      return JSON.parse(localStorage.getItem(HISTORY_KEY) || '[]');
    } catch {
      return [];
    }
  }

  function renderHistory() {
    const items = loadHistory();
    if (!items.length) {
      historyEl.hidden = true;
      return;
    }
    historyEl.hidden = false;
    const cell = (v, unit) => (v === undefined || v === '–' ? '–' : `${v} ${unit}`);
    historyBody.innerHTML = items
      .slice(0, 5)
      .map(
        (h) =>
          `<tr><td>${h.date}</td><td>${cell(h.down, 'Mbps')}</td><td>${cell(h.up, 'Mbps')}</td><td>${cell(h.ping, 'ms')}</td><td>${cell(h.jitter, 'ms')}</td></tr>`
      )
      .join('');
  }

  function saveResult(result) {
    const items = loadHistory();
    items.unshift({
      date: new Date().toLocaleString('en-PK', { dateStyle: 'medium', timeStyle: 'short' }),
      ...result,
    });
    try {
      localStorage.setItem(HISTORY_KEY, JSON.stringify(items.slice(0, 10)));
    } catch {
      /* storage unavailable – ignore */
    }
    renderHistory();
  }

  async function detectServer() {
    try {
      const res = await fetch(META_URL, { cache: 'no-store' });
      const meta = await res.json();
      serverMeta.textContent = meta.clientIp
        ? `Test server: nearest Cloudflare edge · Your IP: ${meta.clientIp}`
        : 'Test server: nearest Cloudflare edge';
    } catch {
      serverMeta.textContent = 'Test server: nearest Cloudflare edge';
    }
  }

  async function measurePing(samples = 8, p0 = 2, p1 = 10) {
    const times = [];
    for (let i = 0; i < samples; i++) {
      if (stopFlag) break;
      const t0 = performance.now();
      await fetch(`${DOWN_URL}?bytes=0&r=${Math.random()}`, { cache: 'no-store' });
      times.push(performance.now() - t0);
      setProgress(p0 + (i / samples) * (p1 - p0));
      await new Promise((r) => setTimeout(r, 60));
    }
    if (!times.length) throw new Error('No ping samples collected');
    const ping = Math.min(...times);
    let jitter = 0;
    if (times.length > 1) {
      let sum = 0;
      for (let i = 1; i < times.length; i++) sum += Math.abs(times[i] - times[i - 1]);
      jitter = sum / (times.length - 1);
    }
    return { ping, jitter };
  }

  async function measureDownload(durationMs = 9000, streams = 4, p0 = 10, p1 = 60) {
    let bytes = 0;
    let active = true;
    const worker = async () => {
      while (active && !stopFlag) {
        try {
          const res = await fetch(`${DOWN_URL}?bytes=25000000&r=${Math.random()}`, { cache: 'no-store' });
          const reader = res.body.getReader();
          for (;;) {
            const { done, value } = await reader.read();
            if (done) break;
            bytes += value.byteLength;
            if (!active || stopFlag) {
              try { await reader.cancel(); } catch { /* noop */ }
              break;
            }
          }
        } catch {
          break;
        }
      }
    };
    const workers = Array.from({ length: streams }, () => worker());

    // Warm-up, then measure over the remaining window.
    await new Promise((r) => setTimeout(r, 1000));
    const t0 = performance.now();
    const b0 = bytes;
    const sampler = setInterval(() => {
      const elapsed = (performance.now() - t0) / 1000;
      if (elapsed > 0.5) {
        const mbps = ((bytes - b0) * 8) / (elapsed * 1e6);
        gaugeNumber.textContent = mbps.toFixed(1);
        setGauge(mbps);
      }
      setProgress(p0 + ((performance.now() - t0) / (durationMs - 1000)) * (p1 - p0));
    }, 200);

    await new Promise((r) => setTimeout(r, durationMs - 1000));
    const t1 = performance.now();
    const b1 = bytes;
    clearInterval(sampler);
    active = false;
    await Promise.allSettled(workers);
    return ((b1 - b0) * 8) / (((t1 - t0) / 1000) * 1e6);
  }

  async function measureUpload(durationMs = 7000, streams = 3, p0 = 60, p1 = 95) {
    const payload = new Uint8Array(256 * 1024);
    // getRandomValues throws if asked for more than 65536 bytes at once,
    // so fill the payload in 64 KiB chunks.
    for (let i = 0; i < payload.length; i += 65536) {
      crypto.getRandomValues(payload.subarray(i, i + 65536));
    }
    let bytes = 0;
    let active = true;
    const worker = async () => {
      while (active && !stopFlag) {
        try {
          await fetch(UP_URL, { method: 'POST', body: payload, cache: 'no-store' });
          bytes += payload.byteLength;
        } catch {
          break;
        }
      }
    };
    const workers = Array.from({ length: streams }, () => worker());

    await new Promise((r) => setTimeout(r, 1000));
    const t0 = performance.now();
    const b0 = bytes;
    const sampler = setInterval(() => {
      const elapsed = (performance.now() - t0) / 1000;
      if (elapsed > 0.5) {
        const mbps = ((bytes - b0) * 8) / (elapsed * 1e6);
        gaugeNumber.textContent = mbps.toFixed(1);
        setGauge(mbps);
      }
      setProgress(p0 + ((performance.now() - t0) / (durationMs - 1000)) * (p1 - p0));
    }, 200);

    await new Promise((r) => setTimeout(r, durationMs - 1000));
    const t1 = performance.now();
    const b1 = bytes;
    clearInterval(sampler);
    active = false;
    await Promise.allSettled(workers);
    return ((b1 - b0) * 8) / (((t1 - t0) / 1000) * 1e6);
  }

  async function runTest() {
    if (running) return;
    running = true;
    stopFlag = false;
    hideError();
    verdictEl.hidden = true;
    resultActions.hidden = true;
    roastCard.hidden = true;
    roastStatus.textContent = '';
    lastNumbers = null;
    setMascot('idle');
    startBtn.disabled = true;
    startBtn.textContent = 'Testing…';
    gaugeUnit.textContent = 'Mbps';
    for (const id of ['res-download', 'res-upload', 'res-ping', 'res-jitter']) $(id).textContent = '–';

    try {
      let result = { down: '–', up: '–', ping: '–', jitter: '–' };
      let verdictHtml = '';

      if (mode === 'ping' || mode === 'jitter') {
        // Ping and jitter only: a few seconds, no download or upload phase.
        setPhase(mode === 'jitter' ? 'Measuring jitter' : 'Measuring ping');
        setProgress(2);
        const samples = mode === 'jitter' ? 20 : 8;
        const { ping, jitter } = await measurePing(samples, 5, 95);
        $('res-ping').textContent = ping.toFixed(0);
        $('res-jitter').textContent = jitter.toFixed(0);
        if (mode === 'jitter') {
          gaugeNumber.textContent = jitter.toFixed(0);
          gaugeUnit.textContent = 'ms jitter';
        } else {
          gaugeNumber.textContent = ping.toFixed(0);
          gaugeUnit.textContent = 'ms ping';
        }
        setGauge(0);
        result = { down: '–', up: '–', ping: ping.toFixed(0), jitter: jitter.toFixed(0) };
        lastNumbers = { down: null, up: null, ping: Math.round(ping), jitter: Math.round(jitter) };
        verdictHtml = mode === 'jitter' ? jitterVerdict(jitter, ping) : pingVerdict(ping);
      } else if (mode === 'upload') {
        // Quick ping for context, then upload only.
        setPhase('Measuring ping');
        setProgress(2);
        const { ping, jitter } = await measurePing(4, 2, 8);
        $('res-ping').textContent = ping.toFixed(0);
        $('res-jitter').textContent = jitter.toFixed(0);
        setPhase('Measuring upload');
        gaugeUnit.textContent = 'Mbps';
        const up = await measureUpload(7000, 3, 10, 96);
        $('res-upload').textContent = up.toFixed(1);
        gaugeNumber.textContent = up.toFixed(1);
        setGauge(up);
        result = { down: '–', up: up.toFixed(1), ping: ping.toFixed(0), jitter: jitter.toFixed(0) };
        lastNumbers = { down: null, up: parseFloat(up.toFixed(1)), ping: Math.round(ping), jitter: Math.round(jitter) };
        verdictHtml = uploadVerdict(up, ping);
      } else {
        setPhase('Measuring ping');
        setProgress(2);
        const { ping, jitter } = await measurePing(8, 2, 10);
        $('res-ping').textContent = ping.toFixed(0);
        $('res-jitter').textContent = jitter.toFixed(0);
        gaugeNumber.textContent = ping.toFixed(0);
        gaugeUnit.textContent = 'ms ping';
        setGauge(0);
        setProgress(10);

        setPhase('Measuring download');
        gaugeUnit.textContent = 'Mbps';
        const down = await measureDownload(9000, 4, 10, 60);
        $('res-download').textContent = down.toFixed(1);
        gaugeNumber.textContent = down.toFixed(1);
        setGauge(down);
        setProgress(60);

        // Upload is the phase most likely to be blocked (VPN, firewall, proxy),
        // so a failure here must not throw away the ping and download results.
        let up = null;
        try {
          setPhase('Measuring upload');
          up = await measureUpload(7000, 3, 60, 96);
          $('res-upload').textContent = up.toFixed(1);
          gaugeNumber.textContent = up.toFixed(1);
          setGauge(up);
        } catch (uploadErr) {
          console.warn('Upload measurement failed', uploadErr);
          setPhase('Upload unavailable');
        }
        setProgress(96);

        result = {
          down: down.toFixed(1),
          up: up === null ? '–' : up.toFixed(1),
          ping: ping.toFixed(0),
          jitter: jitter.toFixed(0),
        };
        lastNumbers = {
          down: parseFloat(down.toFixed(1)),
          up: up === null ? null : parseFloat(up.toFixed(1)),
          ping: Math.round(ping),
          jitter: Math.round(jitter),
        };
        verdictHtml = verdictFor(down, ping);
        if (up === null) {
          verdictHtml +=
            '<p>Upload could not be measured this time, so it is not included above. Your download, ping and jitter results are still valid. Try again in a moment.</p>';
        }
      }

      setPhase('Complete');
      setProgress(100);
      verdictEl.innerHTML = verdictHtml;
      verdictEl.hidden = false;
      resultActions.hidden = false;
      setMascot(moodFor(lastNumbers));
      saveResult(result);
    } catch (err) {
      console.error(err);
      showError(
        'The test could not reach the test server. Check your internet connection and try again. If you use a VPN, ad-blocker or firewall, it may be blocking the test.'
      );
      setPhase('Test failed');
      setMascot('fail');
    } finally {
      running = false;
      startBtn.disabled = false;
      startBtn.textContent = startLabel;
    }
  }

  startBtn.addEventListener('click', runTest);
  $('retest-btn')?.addEventListener('click', runTest);
  $('copy-btn')?.addEventListener('click', async () => {
    const parts = [];
    const down = $('res-download').textContent;
    const up = $('res-upload').textContent;
    const ping = $('res-ping').textContent;
    const jitter = $('res-jitter').textContent;
    if (down !== '–') parts.push(`${down} Mbps down`);
    if (up !== '–') parts.push(`${up} Mbps up`);
    if (ping !== '–') parts.push(`ping ${ping} ms`);
    if (jitter !== '–') parts.push(`jitter ${jitter} ms`);
    const text = `My internet speed: ${parts.join(', ')}, tested at PTCL Speed Test`;
    try {
      await navigator.clipboard.writeText(text);
      $('copy-btn').textContent = 'Copied!';
      setTimeout(() => { $('copy-btn').textContent = 'Copy result'; }, 2000);
    } catch {
      showError('Could not copy automatically. Select the numbers above to copy them manually.');
    }
  });
  $('roast-btn')?.addEventListener('click', async () => {
    if (!lastNumbers) return;
    const text = buildRoast(lastNumbers);
    roastTextEl.textContent = text;
    roastWaLink.href = `https://wa.me/?text=${encodeURIComponent(text)}`;
    roastCard.hidden = false;
    roastStatus.textContent = '';
    const ok = await copyText(text, roastStatus, 'Copied. Paste it on WhatsApp or anywhere you like.');
    const roastBtn = $('roast-btn');
    if (ok && roastBtn) {
      roastBtn.textContent = 'Copied!';
      setTimeout(() => { roastBtn.textContent = 'Roast my speed'; }, 2000);
    }
    roastCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
  $('roast-copy-btn')?.addEventListener('click', async () => {
    const ok = await copyText(roastTextEl.textContent, roastStatus, 'Copied. Paste it on WhatsApp or anywhere you like.');
    const btn = $('roast-copy-btn');
    if (ok && btn) {
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.textContent = 'Copy for WhatsApp'; }, 2000);
    }
  });
  $('clear-history-btn')?.addEventListener('click', () => {
    try { localStorage.removeItem(HISTORY_KEY); } catch { /* noop */ }
    renderHistory();
  });

  renderHistory();
  detectServer();
</script>
